# Read by node --env-file=acres-research/.env from the repository root.
# Replace these absolute paths with private locations on your machine.
ACRES_SECRETS_JSON=/absolute/path/to/arosa/secrets.json
ACRES_STATE_DIR=/absolute/path/to/arosa/state
RESEARCH_HOST=127.0.0.1
RESEARCH_PORT=18800
ACRES_ARCHITECTURE_ENABLED=true
# Enable rendered walkthrough jobs after installing the pinned worker.
# ACRES_ARCHITECTURE_WORKER=/absolute/path/to/arosa-worker/current/bin/architecture-worker
# Optional imported market database; not required for startup.
# ACRES_MARKET_DB=/absolute/path/to/arosa/state/market.sqlite
