[Unit]
Description=Process bounded Acres source refresh requests
After=network-online.target acres-secrets.service
Wants=acres-secrets.service
[Service]
Type=oneshot
User=openclaw
Group=openclaw
WorkingDirectory=/opt/acres-research
Environment=HOME=/home/openclaw
Environment=ACRES_KNOWLEDGE_CONFIG=/run/acres-secrets/knowledge.json
ExecStart=/usr/local/bin/node /opt/acres-research/knowledge-refresh.mjs --queued-only
TimeoutStartSec=25min
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/home/openclaw/.openclaw/acres-state
UMask=0077
