[Unit]
Description=Acres research scheduled judge and memory consolidation (dreaming)
After=network-online.target acres-secrets.service
Wants=network-online.target

[Service]
Type=oneshot
User=openclaw
Group=openclaw
WorkingDirectory=/opt/acres-research
Environment=HOME=/var/lib/arosa
Environment=DREAM_JUDGE=meta
Environment=RESEARCH_SECRETS_PATH=/run/acres-secrets/secrets.json
ExecStart=/usr/local/bin/node /opt/acres-research/dream.mjs
TimeoutStartSec=30min
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/var/lib/arosa /tmp
UMask=0077
