[Unit]
Description=Fetch Acres secrets from Secret Manager into /run
After=network-online.target
Wants=network-online.target
Before=acres-research.service arosa-acres.service

[Service]
Type=oneshot
# No RemainAfterExit: this is a plain boot-time oneshot. It deactivating after the pull
# is expected (is-active shows inactive between boots); consumers declare After= this
# unit and pull it into the boot transaction, so ordering does not need it to stay active.
# The former hourly refresh timer retired 2026-10-18: rotation is update Secret Manager,
# then restart this service and the consumers.
# Boot is the only pull, so it must not give up: retry until Secret Manager answers.
Restart=on-failure
RestartSec=15s
RuntimeDirectory=acres-secrets
RuntimeDirectoryMode=0711
# Keep the files while the unit is inactive between pulls; research reads
# knowledge.json on each use and the env files only exist under /run.
RuntimeDirectoryPreserve=yes
ExecStart=/usr/local/sbin/acres-pull-secrets

[Install]
WantedBy=multi-user.target
