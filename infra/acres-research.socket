[Unit]
Description=Acres research listener
# systemd owns the listening socket and hands it to each research process (fd 3). While one process
# drains and the next starts, new connections wait in the backlog instead of being refused.
[Socket]
ListenStream=127.0.0.1:18800
NoDelay=true
Backlog=4096
Service=acres-research.service
[Install]
WantedBy=sockets.target
