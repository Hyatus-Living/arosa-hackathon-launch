#!/bin/bash
set -euo pipefail
ROOT=/home/openclaw/.openclaw/workspace/acres
[[ $(id -u) == 0 ]]
[[ -r /etc/acres-research/knowledge.json ]]
command -v pdftotext >/dev/null || { echo 'Install poppler-utils before enabling knowledge ingestion.' >&2; exit 1; }
STAGE=$(mktemp -d /opt/acres-research/.knowledge-deps.XXXXXX)
trap 'rm -rf "$STAGE"' EXIT
install -m 644 "$ROOT/package.json" "$ROOT/package-lock.json" "$STAGE/"
npm ci --prefix "$STAGE" --omit=dev --ignore-scripts
install -d -m 755 /opt/acres-research/node_modules
cp -a "$STAGE/node_modules/." /opt/acres-research/node_modules/
install -d -m 700 -o openclaw -g openclaw /home/openclaw/.openclaw/acres-state
for FILE in knowledge.mjs knowledge-providers.mjs knowledge-refresh.mjs knowledge-query.mjs; do
  install -m 644 "$ROOT/acres-research/$FILE" "/opt/acres-research/$FILE"
done
install -m 644 "$ROOT/acres-research/knowledge-sources.json" /opt/acres-research/
for UNIT in acres-knowledge.service acres-knowledge.timer acres-knowledge-queued.service acres-knowledge-queued.timer; do
  install -m 644 "$ROOT/infra/$UNIT" "/etc/systemd/system/$UNIT"
done
systemctl daemon-reload
systemctl start acres-knowledge.service
systemctl enable --now acres-knowledge.timer acres-knowledge-queued.timer
systemctl list-timers acres-knowledge.timer acres-knowledge-queued.timer --no-pager
