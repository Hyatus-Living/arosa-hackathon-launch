[Unit]
Description=Acres NYC research backend
After=network-online.target acres-secrets.service
# Ordered after the secrets oneshot, which is enabled on its own, so the boot pulls secrets first.
# Neither Wants nor Requires: restarting the secrets oneshot must not restart research, and a
# research restart (every deploy) must not pull secrets again and wait for it.
# Research uses read-only systemd credentials. Restart after a secret rotation.
Wants=network-online.target
# The listener is acres-research.socket's, so a restart never refuses a connection. Stopping only
# the service is not enough to keep research down: the socket starts it on the next connection.
Requires=acres-research.socket
After=acres-research.socket
[Service]
Type=simple
User=acres-runtime
Group=acres-runtime
WorkingDirectory=/opt/acres-research
Environment=HOME=/var/lib/arosa
Environment=ACRES_STATE_DIR=/var/lib/arosa
LoadCredential=knowledge.json:/run/acres-secrets/knowledge.json
LoadCredential=secrets.json:/run/acres-secrets/secrets.json
Environment=ACRES_KNOWLEDGE_CONFIG=%d/knowledge.json
Environment=ACRES_SECRETS_JSON=%d/secrets.json
EnvironmentFile=/var/lib/arosa/openclaw/gateway.env
EnvironmentFile=/run/acres-secrets/gateway-secrets.env
# Runs as root before every start, after the previous process has exited: installs the release that
# acres-deploy-research staged in /opt/acres-research/.next, if any (see acres-research-apply).
ExecStartPre=+/usr/local/sbin/acres-research-apply
ExecStart=/usr/local/bin/node /opt/acres-research/service.mjs
Restart=on-failure
RestartSec=5
# SIGTERM drains (service.mjs): the process keeps serving, starts no new runs (they stay queued for
# the next process) and lets in-flight runs finish on their own deadline, at most 20 minutes (the
# drain waits 21.5). Signal only node so the Codex children it is still using keep running.
KillMode=mixed
TimeoutStopSec=23min
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/var/lib/arosa /tmp
ProtectHome=read-only
UMask=0077
[Install]
WantedBy=multi-user.target
