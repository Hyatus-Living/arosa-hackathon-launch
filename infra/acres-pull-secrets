#!/usr/bin/env bash
# Pulls the Arosa app secrets from Google Secret Manager into /run/acres-secrets (tmpfs) using
# the VM's own identity, which holds secretAccessor on the resources in an operator-owned mapping file.
# Secret values never touch durable disk: /run clears on reboot and this runs before the app
# services start (acres-secrets.service, at boot). To rotate a key: update Secret Manager,
# then restart acres-secrets.service and the consuming services. Non-secret configuration
# is merged from
# /etc/acres-research/config.json (or, during transition, the legacy secrets.json).
# Overrides for testing: ACRES_SECRETS_OUT, ACRES_CONFIG_JSON, ACRES_APP_ENV_TEMPLATE,
# ACRES_KNOWLEDGE_TEMPLATE.
set -euo pipefail
: "${ACRES_GCP_PROJECT:?Set your deployment project}"
: "${ACRES_SECRET_MAP_JSON:?Set the private env-key-to-secret-name JSON file}"
PROJECT=$ACRES_GCP_PROJECT
OUT=${ACRES_SECRETS_OUT:-/run/acres-secrets}
CONFIG_JSON=${ACRES_CONFIG_JSON:-/etc/acres-research/config.json}
LEGACY_JSON=/etc/acres-research/secrets.json
APP_TEMPLATE=${ACRES_APP_ENV_TEMPLATE:-/etc/arosa-acres.env}
export PROJECT OUT CONFIG_JSON LEGACY_JSON APP_TEMPLATE
exec python3 - <<'PY'
import base64, json, os, shlex, sys, time, urllib.error, urllib.request

PROJECT = os.environ['PROJECT']
OUT = os.environ['OUT']
# Public configuration keys are stable; Secret Manager resource names stay private.
with open(os.environ['ACRES_SECRET_MAP_JSON']) as source:
    SECRET_KEYS = json.load(source)
OPTIONAL_KEYS = {'SENDGRID_API_KEY', 'LOOPNET_API_KEY', 'STRIPE_SECRET_KEY',
                 'STRIPE_SUBSCRIPTION_WEBHOOK_SECRET', 'TREG_TOKEN', 'GEMINI_RESEARCH_API_KEY'}
RESEARCH_JSON_KEYS = ['RESEARCH_TOKEN', 'GOOGLE_MAPS_API_KEY', 'DEEPSEEK_API_KEY', 'MCP_SERVICE_TOKEN',
                      'CLOUDFLARE_API_TOKEN', 'COMPOSIO_API_KEY', 'COMPOSIO_USER_API_KEY', 'SERPER_API_KEY', 'SENDGRID_API_KEY',
                      'LOOPNET_API_KEY', 'TREG_TOKEN', 'GEMINI_RESEARCH_API_KEY', 'MODEL_API_KEY']
GATEWAY_KEYS = ['ACRES_SOCRATA_APP_TOKEN', 'PASCAL_MAP_API_KEY']
APP_KEYS = ['RESEARCH_TOKEN', 'GOOGLE_MAP_TILES_API_KEY', 'STRIPE_SECRET_KEY', 'STRIPE_SUBSCRIPTION_WEBHOOK_SECRET']
KNOWLEDGE_KEYS = ['OPENROUTER_API_KEY', 'TYPESAFE_API_KEY']

def token():
    last = None
    for attempt in range(6):
        try:
            req = urllib.request.Request(
                'http://metadata.google.internal/computeMetadata/v1/instance/service-accounts/default/token',
                headers={'Metadata-Flavor': 'Google'})
            with urllib.request.urlopen(req, timeout=10) as r:
                return json.loads(r.read())['access_token']
        except Exception as e:
            last = e; time.sleep(2 * (attempt + 1))
    raise RuntimeError(f'metadata token failed: {last}')

def fetch(secret_id):
    url = f'https://secretmanager.googleapis.com/v1/projects/{PROJECT}/secrets/{secret_id}/versions/latest:access'
    last = None
    for attempt in range(4):
        try:
            req = urllib.request.Request(url, headers={'Authorization': f'Bearer {TOK}'})
            with urllib.request.urlopen(req, timeout=20) as r:
                return base64.b64decode(json.loads(r.read())['payload']['data']).decode()
        except Exception as e:
            last = e; time.sleep(2 * (attempt + 1))
    raise RuntimeError(f'secret {secret_id} fetch failed: {last}')

def load_json(path):
    try:
        with open(path) as f: return json.load(f)
    except (FileNotFoundError, json.JSONDecodeError):
        return {}

config = load_json(os.environ['CONFIG_JSON']) or {
    k: v for k, v in load_json(os.environ['LEGACY_JSON']).items() if k not in SECRET_KEYS}
if config.get('LISTING_RESEARCH_ENABLED') is True and config.get('LISTING_RESEARCH_PROVIDER', 'meta') == 'gemini':
    # Listing research cannot run without the key, so it is required while that is on.
    OPTIONAL_KEYS.discard('GEMINI_RESEARCH_API_KEY')
keys = set(RESEARCH_JSON_KEYS + GATEWAY_KEYS + APP_KEYS + KNOWLEDGE_KEYS)
missing = sorted(key for key in keys - OPTIONAL_KEYS if not SECRET_KEYS.get(key))
if missing: raise RuntimeError(f'Missing required secret mappings: {missing}')
TOK = token()

# Fetch every key independently. Each output file is then written only when all of its
# required keys arrived; a file whose keys failed keeps its previous copy when one exists,
# so one revoked or unreachable secret cannot blank the files that do not depend on it.
values, fetch_errors = {}, {}
for key in sorted(keys):
    try:
        values[key] = fetch(SECRET_KEYS[key]) if SECRET_KEYS.get(key) else ''
    except Exception as e:
        values[key] = ''
        if key not in OPTIONAL_KEYS: fetch_errors[key] = str(e)

os.makedirs(OUT, exist_ok=True)
def write(name, text, mode, uid_gid=None):
    tmp = os.path.join(OUT, f'.{name}.tmp')
    with open(tmp, 'w') as f: f.write(text)
    os.chmod(tmp, mode)
    if uid_gid: os.chown(tmp, *uid_gid)
    os.replace(tmp, os.path.join(OUT, name))

import pwd, sys
try: oc = (lambda p: (p.pw_uid, p.pw_gid))(pwd.getpwnam('openclaw'))
except KeyError: oc = None

fatal, stale = [], []
def emit(name, required_keys, render, mode, uid_gid=None):
    missing = [k for k in required_keys if not values.get(k)]
    if not missing:
        write(name, render(), mode, uid_gid)
    elif os.path.exists(os.path.join(OUT, name)):
        stale.append(f'{name} (kept previous copy; missing {missing})')
        print(f'acres-pull-secrets: WARNING keeping previous {name}; unfetched keys: {missing}', file=sys.stderr)
    else:
        fatal.append(f'{name} (missing {missing})')

emit('secrets.json', [k for k in RESEARCH_JSON_KEYS if k not in OPTIONAL_KEYS],
     lambda: json.dumps({**config, **{k: values[k] for k in RESEARCH_JSON_KEYS}}) + '\n', 0o400, oc)
knowledge_template = {k: v for k, v in load_json(os.environ.get('ACRES_KNOWLEDGE_TEMPLATE', '/etc/acres-research/knowledge.json')).items() if k not in SECRET_KEYS}
emit('knowledge.json', KNOWLEDGE_KEYS,
     lambda: json.dumps({**knowledge_template, **{k: values[k] for k in KNOWLEDGE_KEYS}}) + '\n', 0o400, oc)
emit('gateway-secrets.env', GATEWAY_KEYS,
     lambda: ''.join(f'{k}={shlex.quote(values[k])}\n' for k in GATEWAY_KEYS), 0o400, oc)

def render_app_env():
    app_lines = []
    try:
        for line in open(os.environ['APP_TEMPLATE']):
            key = line.split('=', 1)[0].strip() if '=' in line else ''
            # Drop a template line only when a fetched value replaces it. An optional secret
            # that is still missing leaves the template line in place and appends nothing,
            # so a sandbox key installed in the template keeps working until Secret Manager
            # holds the durable copy, and boot never waits on an optional key.
            if key not in APP_KEYS or not values.get(key): app_lines.append(line if line.endswith('\n') else line + '\n')
    except FileNotFoundError:
        pass
    app_lines += [f'{k}={shlex.quote(values[k])}\n' for k in APP_KEYS if values.get(k)]
    return ''.join(app_lines)
emit('app.env', [k for k in APP_KEYS if k not in OPTIONAL_KEYS], render_app_env, 0o600)

if fatal:
    raise RuntimeError(f'required outputs could not be built: {fatal}; fetch errors: {fetch_errors}')
print(f'acres-pull-secrets: wrote secrets to {OUT}' + (f'; stale-kept: {stale}' if stale else ''))
PY
