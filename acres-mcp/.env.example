# Non-secret placeholders. No usable credentials are supplied.
MCP_PUBLIC_URL=https://mcp.witharosa.ai/mcp
# Arosa identity (login.witharosa.ai) is the live OAuth issuer: Better Auth,
# RS256 resource tokens (acres:read, 600s), explicit consent, open Dynamic
# Client Registration for MCP clients, and public email sign-up.
MCP_OAUTH_ISSUER=https://login.witharosa.ai/api/auth
MCP_OAUTH_JWKS_URL=https://login.witharosa.ai/api/auth/jwks
MCP_BACKEND_URL=http://10.42.0.2:18800
MCP_MEMBERSHIPS_FILE=/run/acres/memberships.json
# Verified subjects with no membership row get an isolated public account.
MCP_PUBLIC_ACCESS=true
# Exact OpenAI directory domain-verification token from the submission
# portal, served as plain text at /.well-known/openai-apps-challenge.
# OPENAI_APPS_CHALLENGE_TOKEN=PASTE_PORTAL_TOKEN
# Bind MCP_SERVICE_TOKEN securely; it is a separate private-service credential.
# Optional exact additional Cloud Run hostname/origins, comma-separated:
# MCP_ALLOWED_HOSTS=acres-mcp-EXAMPLE.us-central1.run.app
# MCP_ALLOWED_ORIGINS=https://chatgpt.com
PORT=8080
NODE_USE_ENV_PROXY=1
