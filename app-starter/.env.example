# Read by node --env-file=.env server.js from app-starter/.
HOST=127.0.0.1
PORT=8080
ACRES_RESEARCH_ORIGIN=http://127.0.0.1:18800
RESEARCH_TOKEN=replace-with-the-same-private-token-as-the-research-service
AROSA_ACCESS_ISSUER=https://your-team.cloudflareaccess.com
AROSA_ACCESS_AUD=replace-with-your-access-application-audience
AROSA_ADMIN_EMAILS=you@example.com
AROSA_APP_ORIGINS=https://your-arosa-host.example.com
ACRES_ARCHITECTURE_ENABLED=true
BILLING_ENABLED=false

# Optional public beta-site proxy: share a separate random token of at least 32 characters with site/proxy.
AROSA_SITE_PROXY_SECRET=
