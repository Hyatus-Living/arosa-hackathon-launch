# Frontend gateway deployment. Do not commit a filled .env.
AROSA_ACCESS_ISSUER=https://your-team.cloudflareaccess.com
AROSA_ACCESS_AUD=your-application-audience
AROSA_ADMIN_EMAILS=admin@example.com
ACRES_ARCHITECTURE_ENABLED=true
RESEARCH_TOKEN=replace-with-a-strong-private-shared-token
# Research providers belong in the private JSON file selected by ACRES_SECRETS_JSON.
ACRES_SECRETS_JSON=/absolute/path/to/private-research-config.json
